<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head', { title: 'Forgot Password' }) %></head>
<body class="p-0 m-0" style="background:none;">

<div class="auth-bg">
  <div class="w-100 px-3 d-flex flex-column align-items-center py-4">

    <!-- Brand -->
    <div class="text-center mb-4 position-relative" style="z-index:2;">
      <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-3" style="width:64px;height:64px;background:rgba(255,255,255,0.15);">
        <i class="bi bi-calendar2-check text-white" style="font-size:28px;"></i>
      </div>
      <h1 class="text-white fw-bold mb-1" style="font-family:'Poppins',sans-serif;font-size:2rem;">Attent<span style="color:#93c5fd;">75</span></h1>
      <p class="text-white-50 mb-0 small">We will email you a code.</p>
    </div>

    <!-- Card -->
    <div class="auth-card bg-white">

      <h2 class="fw-bold mb-1" style="font-family:'Poppins',sans-serif;font-size:1.5rem;color:#1a3a5c;">Forgot password?</h2>
      <p class="text-muted mb-4 small">Enter your email and we will send a 6 digit code to reset it</p>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success d-flex align-items-center gap-2 rounded-3 py-2 mb-4">
          <i class="bi bi-check-circle-fill text-success"></i>
          <span><%= success %></span>
        </div>
      <% } %>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger d-flex align-items-center gap-2 rounded-3 py-2 mb-4">
          <i class="bi bi-exclamation-circle-fill text-danger"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form action="/forgot-password" method="POST" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="mb-4">
          <label class="form-label" for="email">
            <i class="bi bi-envelope me-1 text-primary"></i> Email Address
          </label>
          <input
            type="email"
            name="email"
            id="email"
            class="form-control form-control-lg"
            placeholder="you@gmail.com"
            value="<%= typeof formData !== 'undefined' ? formData.email : '' %>"
            required
          >
        </div>

        <button type="submit" class="btn btn-primary w-100 btn-lg mb-3">
          <i class="bi bi-send me-2"></i>Send Code
        </button>
      </form>

      <p class="text-center text-muted mb-0 small">
        Remembered it?
        <a href="/login" class="text-primary fw-semibold text-decoration-none">Back to sign in</a>
      </p>

    </div>

    <p class="text-white-50 small mt-4 position-relative" style="z-index:2;">&copy; <%= new Date().getFullYear() %> Attent75</p>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
