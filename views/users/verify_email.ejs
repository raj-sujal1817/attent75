<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head', { title: 'Verify Email' }) %>
<style>
  .otp-row { display:flex; gap:8px; justify-content:center; }
  .otp-box {
    width:46px; height:56px; text-align:center; font-size:1.5rem; font-weight:700;
    font-family:'Poppins',sans-serif; color:#1a3a5c;
    border:1.5px solid #e2e8f0; border-radius:12px; background:#f8faff; outline:none;
  }
  .otp-box:focus { border-color:#2563eb; box-shadow:0 0 0 3px rgba(37,99,235,.15); background:#fff; }
  @media (max-width:380px) { .otp-box { width:40px; height:50px; font-size:1.3rem; } .otp-row { gap:6px; } }
</style>
</head>
<body class="p-0 m-0" style="background:none;">

<div class="auth-bg">
  <div class="w-100 px-3 d-flex flex-column align-items-center py-4">

    <!-- Brand -->
    <div class="text-center mb-4 position-relative" style="z-index:2;">
      <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-3" style="width:64px;height:64px;background:rgba(255,255,255,0.15);">
        <i class="bi bi-calendar2-check text-white" style="font-size:28px;"></i>
      </div>
      <h1 class="text-white fw-bold mb-1" style="font-family:'Poppins',sans-serif;font-size:2rem;">Attent<span style="color:#93c5fd;">75</span></h1>
      <p class="text-white-50 mb-0 small">One last step before you start.</p>
    </div>

    <!-- Card -->
    <div class="auth-card bg-white">

      <div class="text-center mb-3">
        <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-2" style="width:52px;height:52px;background:#dbeafe;color:#2563eb;font-size:24px;">
          <i class="bi bi-envelope-check"></i>
        </div>
        <h2 class="fw-bold mb-1" style="font-family:'Poppins',sans-serif;font-size:1.5rem;color:#1a3a5c;">Verify your email</h2>
        <p class="text-muted mb-0 small">We sent a 6 digit code to<br><strong style="color:#1a3a5c;"><%= maskedEmail %></strong></p>
      </div>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success d-flex align-items-center gap-2 rounded-3 py-2 mb-4">
          <i class="bi bi-check-circle-fill text-success"></i>
          <span><%= success %></span>
        </div>
      <% } %>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger d-flex align-items-center gap-2 rounded-3 py-2 mb-4">
          <i class="bi bi-exclamation-circle-fill text-danger"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form action="/verify-email" method="POST" id="otpForm" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="otp-row mb-3">
            <% for (var i = 0; i < 6; i++) { %>
              <input class="otp-box" type="text" inputmode="numeric" autocomplete="<%= i === 0 ? 'one-time-code' : 'off' %>" maxlength="6" aria-label="Digit <%= i + 1 %>">
            <% } %>
          </div>
          <input type="hidden" name="code" id="code">

        <button type="submit" class="btn btn-primary w-100 btn-lg mb-3">
          <i class="bi bi-shield-check me-2"></i>Verify &amp; Continue
        </button>
      </form>

      <form action="/verify-email/resend" method="POST" class="mb-2">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" id="resendBtn" data-wait="<%= typeof resendIn !== 'undefined' ? resendIn : 0 %>" class="btn btn-outline-primary w-100">
          <i class="bi bi-arrow-repeat me-1"></i><span id="resendLabel">Resend code</span>
        </button>
      </form>

      <p class="text-center text-muted small mt-3 mb-1">
        <i class="bi bi-clock me-1"></i>The code works for 10 minutes. Check your Spam folder too.
      </p>

      <form action="/verify-email/change" method="POST" class="text-center mb-0">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-link btn-sm text-decoration-none p-0">Wrong email? Go back</button>
      </form>

    </div>

    <p class="text-white-50 small mt-4 position-relative" style="z-index:2;">&copy; <%= new Date().getFullYear() %> Attent75</p>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  (function () {
    var boxes = Array.prototype.slice.call(document.querySelectorAll('.otp-box'));
    var hidden = document.getElementById('code');
    var form = document.getElementById('otpForm');

    function collect() {
      hidden.value = boxes.map(function (b) { return b.value; }).join('');
      return hidden.value;
    }

    var pwd = document.getElementById('password');

    // 6 digits entered: the verify page submits by itself, the reset page moves on to the password box
    function done() {
      if (pwd) { pwd.focus(); return; }
      form.requestSubmit();
    }

    function fill(digits) {
      digits = (digits || '').replace(/\D/g, '').slice(0, boxes.length);
      boxes.forEach(function (b, i) { b.value = digits[i] || ''; });
      var next = Math.min(digits.length, boxes.length - 1);
      boxes[next].focus();
      if (collect().length === boxes.length) done();
    }

    boxes.forEach(function (box, i) {
      box.addEventListener('input', function () {
        var v = box.value.replace(/\D/g, '');
        if (v.length > 1) { fill(v); return; }          // pasted / autofilled several digits
        box.value = v;
        if (v && i < boxes.length - 1) boxes[i + 1].focus();
        if (collect().length === boxes.length) done();
      });
      box.addEventListener('keydown', function (e) {
        if (e.key === 'Backspace' && !box.value && i > 0) { boxes[i - 1].focus(); boxes[i - 1].value = ''; collect(); }
        if (e.key === 'ArrowLeft' && i > 0) boxes[i - 1].focus();
        if (e.key === 'ArrowRight' && i < boxes.length - 1) boxes[i + 1].focus();
      });
      box.addEventListener('paste', function (e) {
        e.preventDefault();
        fill((e.clipboardData || window.clipboardData).getData('text'));
      });
      box.addEventListener('focus', function () { box.select(); });
    });

    form.addEventListener('submit', function (e) {
      if (collect().length !== boxes.length) {
        e.preventDefault();
        var first = boxes.filter(function (b) { return !b.value; })[0] || boxes[0];
        first.focus();
        return;
      }
      var btn = form.querySelector('button[type="submit"]');
      if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Checking...'; }
    });

    boxes[0].focus();
  })();

  // Resend countdown
  (function () {
    var btn = document.getElementById('resendBtn');
    var label = document.getElementById('resendLabel');
    if (!btn) return;
    var left = parseInt(btn.getAttribute('data-wait'), 10) || 0;

    function paint() {
      if (left > 0) { btn.disabled = true; label.textContent = 'Resend code in ' + left + 's'; }
      else { btn.disabled = false; label.textContent = 'Resend code'; }
    }
    paint();
    if (left > 0) {
      var t = setInterval(function () { left--; paint(); if (left <= 0) clearInterval(t); }, 1000);
    }
  })();
</script>
</body>
</html>
