<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head', { title: 'Mark Attendance' }) %></head>
<body>

<!-- <%- include('../partials/navbar', { page: 'attendance', user: typeof user !== 'undefined' ? user : { username: 'Rahul' } }) %> -->

<main class="container-fluid px-4 py-4" style="max-width:800px;">

  <div class="mb-4">
    <h2 class="fw-bold mb-1" style="font-family:'Poppins',sans-serif;color:#1a3a5c;">
      <i class="bi bi-calendar-check me-2 text-primary"></i>
      Update Attendance
    </h2>

    <p class="text-muted mb-0">
      <i class="bi bi-calendar3 me-1"></i>
      <%= new Date(record.date).toLocaleDateString('en-IN', {
        weekday:'long',
        year:'numeric',
        month:'long',
        day:'numeric'
      }) %>
    </p>
  </div>


  <div class="row g-4 justify-content-center">

    <div class="col-12 col-md-6 col-lg-4">

      <div class="card attendance-card h-100 p-4 position-relative">

        <div class="text-center mb-4">

          <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-2"
               style="width:48px;height:48px;background:#dbeafe;color:#2563eb;font-size:20px;">
            <i class="bi bi-journal-text"></i>
          </div>

          <h5 class="fw-bold mb-1" style="color:#1a3a5c;">
            <%= record.subjectName %>
          </h5>

          <small class="text-muted">
            <i class="bi bi-clock me-1"></i>
            <%= record.startTime %> - <%= record.endTime %>
          </small>

        </div>


        <form action="/attendance/<%= record._id %>" method="POST" class="d-grid gap-2">

          <button
            type="submit"
            name="status"
            value="present"
            class="btn <%= record.status === 'present' ? 'btn-success' : 'btn-secondary' %>">
            <i class="bi bi-check-circle"></i>
            Mark Present
          </button>


          <button
            type="submit"
            name="status"
            value="absent"
            class="btn <%= record.status === 'absent' ? 'btn-danger' : 'btn-secondary' %>">
            <i class="bi bi-x-circle"></i>
            Mark Absent
          </button>


          <button
            type="submit"
            name="status"
            value="holiday"
            class="btn <%= record.status === 'holiday' ? 'btn-primary' : 'btn-secondary' %>">
            <i class="bi bi-calendar-check"></i>
            Holiday
          </button>


          <button
            type="submit"
            name="status"
            value="cancel"
            class="btn <%= record.status === 'cancel' ? 'btn-warning' : 'btn-secondary' %>">
            <i class="bi bi-calendar-x"></i>
            Class Cancel
          </button>

        </form>

      </div>

    </div>

  </div>


  <div class="mt-4 text-center">

    <a href="/attendance/history" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i>
      Back to History
    </a>

  </div>

</main>

<%- include('../partials/footer') %>


<script>
  const btn = document.querySelector(".present");
  btn.addEventListener("click",() => {
    btn.classList.remove("btn-secondary");
    btn.classList.add("btn-success");
  });
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
